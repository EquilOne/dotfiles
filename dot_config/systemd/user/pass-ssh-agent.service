[Unit]
Description=Proton Pass SSH agent daemon (serves keys from the ssh-keys vault)
After=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PROTON_PASS_KEY_PROVIDER=fs
ExecStart=%h/.local/bin/pass-cli ssh-agent daemon start \
    --vault-name ssh-keys \
    --socket-path %h/.ssh/proton-pass-agent.sock \
    --log-file %h/.local/state/proton-pass-agent.log
ExecStop=%h/.local/bin/pass-cli ssh-agent daemon stop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
