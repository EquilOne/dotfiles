{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 2,
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "@franlol/opencode-md-table-formatter@latest"
  ],
  "mcp": {
    "openrouter": {
      "type": "remote",
      "url": "https://mcp.openrouter.ai/mcp",
      "enabled": false
    },
    "exa": {
      "type": "remote",
      "url": "https://exa.openrouter.ai/mcp",
      "enabled": true
    }
  },
  "formatter": true,
  "autoupdate": true,
  "default_agent": "fixer",
  "small_model": "openrouter/google/gemini-2.5-flash-lite",
  "agent": {
    "plan": {
      "model": "openrouter/z-ai/glm-5.2",
      "reasoningEffort": "high"
    },
    "build": {
      "model": "openrouter/z-ai/glm-5.2",
      "reasoningEffort": "xhigh"
    },
    "explore": {
      "model": "openrouter/deepseek/deepseek-v4-flash"
    },
    "general": {
      "model": "openrouter/deepseek/deepseek-v4-flash"
    },
    "scout": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash"
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.2": {
          "options": {
            "reasoningEffort": "xhigh",
            "verbosity": "low",
            "provider": {
              "sort": "latency"
            }
          }
        },
        "deepseek/deepseek-v4-flash": {
          "options": {
            "reasoningEffort": "high",
            "verbosity": "low",
            "provider": {
              "sort": "throughput"
            }
          }
        },

        "openai/gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "xhigh",
            "verbosity": "low",
            "provider": {
              "sort": "throughput"
            }
          }
        },
        "google/gemini-2.5-flash-lite": {
          "options": {
            "verbosity": "low",
            "provider": {
              "sort": "price"
            }
          }
        }
      }
    }
  }
}
