{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "@franlol/opencode-md-table-formatter@latest"
  ],
  "autoupdate": false,
  "default_agent": "chat",
  "agent": {
    "plan": {
      "model": "openrouter/deepseek/deepseek-v4-flash"
    },
    "build": {
      "model": "openrouter/minimax/minimax-m3"
    },
    "explore": {
      "model": "openrouter/deepseek/deepseek-v4-flash"
    },
    "general": {
      "model": "openrouter/deepseek/deepseek-v4-flash"
    }
  }
}
