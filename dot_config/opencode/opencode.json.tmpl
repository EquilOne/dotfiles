{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 2,
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "@franlol/opencode-md-table-formatter@latest"
  ],
  "mcp": {
    "openrouter": {
      "type": "remote",
      "url": "https://mcp.openrouter.ai/mcp",
      "enabled": false
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true{{ if eq .profile "remote" }},
      "headers": {
        "Authorization": "Bearer {{ protonPass "pass://SZZ4VITnWMje2Df01Z_-6XJ52UXWIdpywga9uE26vwLE1q4JNzB1GWivdRbO5d1u6iy71wgIMYTH6xb7CYjG1A==/SvWLUqs2yNztw5xe7sQzWJ56L2nZhNYf24sa6FOvDaPmMtcyXFyG9L2qJjgwZMEMG7p5mVIAcpOC-csgNsHQOA==/API Key" | trim }}"
      }{{ end }}
    },
    "airtable": {
      "type": "remote",
      "url": "https://mcp.airtable.com/mcp",
      "enabled": false
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true
    }
  },
  "formatter": true,
  "autoupdate": true,
  "default_agent": "fixer",
  "small_model": "openrouter/google/gemini-2.5-flash-lite",
  "agent": {
    "plan": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5.6-luna",
      "reasoningEffort": "high",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        },
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny",
        "question": "allow",
        "todowrite": "allow",
        "external_directory": "deny"
      }
    },
    "build": {
      "mode": "primary",
      "model": "openrouter/openai/gpt-5.6-luna",
      "reasoningEffort": "xhigh",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "allow",
        "external_directory": "ask"
      }
    },
    "explore": {
      "model": "openrouter/deepseek/deepseek-v4-flash-0731"
    },
    "general": {
      "model": "openrouter/deepseek/deepseek-v4-flash-0731"
    },
    "scout": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731"
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.2": {
          "options": {
            "reasoningEffort": "xhigh",
            "verbosity": "low",
            "provider": {
              "sort": "latency"
            }
          }
        },
        "deepseek/deepseek-v4-flash-0731": {
          "options": {
            "reasoningEffort": "high",
            "verbosity": "low",
            "provider": {
              "sort": "throughput"
            }
          }
        },

        "openai/gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "xhigh",
            "verbosity": "low",
            "provider": {
              "sort": "price"
            }
          }
        },

        "openai/gpt-5.6-terra": {
          "options": {
            "reasoningEffort": "high",
            "verbosity": "low",
            "provider": {
              "sort": "price"
            }
          }
        },
        "google/gemini-3.7-flash": {
          "options": {
            "reasoningEffort": "high",
            "verbosity": "low",
            "provider": {
              "sort": "price"
            }
          }
        },
        "google/gemini-2.5-flash-lite": {
          "options": {
            "verbosity": "low",
            "provider": {
              "sort": "throughput"
            }
          }
        },
        "openai/gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "xhigh",
            "verbosity": "low",
            "provider": {
              "sort": "price"
            }
          }
        },
        "xiaomi/mimo-v2.5": {
          "options": {
            "reasoningEffort": "medium",
            "verbosity": "low",
            "provider": {
              "sort": "throughput"
            }
          }
        }
      }
    }
  }
}
