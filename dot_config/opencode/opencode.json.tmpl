{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "experimental": {
    "subagent_depth": 2
  },
  "mcp": {
    "servers": {
      "openrouter": {
        "type": "remote",
        "url": "https://mcp.openrouter.ai/mcp",
        "disabled": true
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "disabled": false{{ if eq .profile "remote" }},
        "headers": {
          "Authorization": "Bearer {{ protonPass "pass://SZZ4VITnWMje2Df01Z_-6XJ52UXWIdpywga9uE26vwLE1q4JNzB1GWivdRbO5d1u6iy71wgIMYTH6xb7CYjG1A==/SvWLUqs2yNztw5xe7sQzWJ56L2nZhNYf24sa6FOvDaPmMtcyXFyG9L2qJjgwZMEMG7p5mVIAcpOC-csgNsHQOA==/API Key" | trim }}"
        }{{ end }}
      },
      "airtable": {
        "type": "remote",
        "url": "https://mcp.airtable.com/mcp",
        "disabled": true
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp",
        "disabled": true
      }
    }
  },
  "formatter": true,
  "default_agent": "fixer",
  "agents": {
    "title": {
      "model": "openrouter/google/gemini-2.5-flash-lite"
    },
    "plan": {
      "mode": "subagent",
      "model": "openrouter/openai/gpt-5.6-luna#xhigh",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "deny" }
      ]
    },
    "build": {
      "mode": "primary",
      "model": "openrouter/openai/gpt-5.6-luna#xhigh",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "ask" }
      ]
    },
    "explore": {
      "model": "openrouter/z-ai/glm-5.3-flash#high"
    },
    "general": {
      "model": "openrouter/z-ai/glm-5.3-flash#high"
    }
  },
  "providers": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.2": {
          "settings": {
            "reasoningEffort": "xhigh",
            "verbosity": "low",
            "provider": { "sort": "latency" }
          }
        },
        "z-ai/glm-5.3": {
          "settings": {
            "reasoningEffort": "xhigh",
            "verbosity": "low",
            "provider": { "order": ["sail-research"], "allow_fallbacks": false }
          },
          "variants": [
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "z-ai/glm-5.3-flash": {
          "settings": {
            "reasoningEffort": "max",
            "verbosity": "low",
            "provider": { "sort": "throughput" }
          },
          "variants": [
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } }
          ]
        },
        "openai/gpt-5.6-luna": {
          "settings": {
            "reasoningEffort": "xhigh",
            "verbosity": "low",
            "provider": { "sort": "price" }
          },
          "variants": [
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai/gpt-5.6-luna-pro": {
          "settings": {
            "reasoningEffort": "xhigh",
            "verbosity": "low",
            "provider": { "sort": "latency" }
          },
          "variants": [
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "openai/gpt-6-sol": {
          "settings": {
            "reasoningEffort": "high",
            "verbosity": "low",
            "provider": { "sort": "price" }
          },
          "variants": [
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        },
        "google/gemini-3.7-flash": {
          "settings": {
            "reasoningEffort": "high",
            "verbosity": "low",
            "provider": { "sort": "price" }
          }
        },
        "google/gemini-2.5-flash-lite": {
          "settings": {
            "verbosity": "low",
            "provider": { "sort": "throughput" }
          }
        },
        "openai/gpt-5.6-sol": {
          "settings": {
            "reasoningEffort": "xhigh",
            "verbosity": "low",
            "provider": { "sort": "price" }
          }
        },
        "xiaomi/mimo-v2.5": {
          "settings": {
            "reasoningEffort": "medium",
            "verbosity": "low",
            "provider": { "sort": "throughput" }
          }
        },
        "inception/mercury-2.5": {
          "variants": [
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } }
          ]
        }
      }
    }
  }
}
