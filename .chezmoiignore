{{- /* Ignore matrix: B's profile/omarchyVersion rules + A's flat
     machine-local state patterns + pinetab-only gating. The pinetab-only
     configs (foot, fuzzel, GTK, themes, classic hypr stack) only apply on
     the danctnix device — ignored everywhere else. */ -}}

# ── Universal: backups, editor junk, vendored git dirs ─────────────────
.bak*
.bak/**
# Nested backup files anywhere in the tree (e.g. nvim/lua/plugins/themes.lua.bak,
# bat/rose-pine-moon.tmTheme.bak) that the root `.bak*`/`.bak/**` patterns miss.
**/*.bak
.git
.git/**
**/.git
**/.git/**
nvim/*
!nvim/lua
!nvim/lua/**
!nvim/.gitignore

# Environment files
# (shell/env.local is intentionally NOT ignored: managed via env.local.tmpl
# which renders the EXA_API_KEY from Proton Pass — see dot_config/shell/)
**/*.env
**/env.*
!.config/shell/env.local

# Repository documentation (not deployed).
docs/**
AGENTS.md

# Dead .conf files under the Hyprland 0.56 lua config — omarchy owns the live
# config (~/.config/hypr/*.lua); these vendored .conf copies are obsolete and the
# xdph.conf delta is only a cosmetic comment reorder. Unconditional (all profiles).

# ── Machine-local state (A) — never managed ─────────────────────────────
# node_modules are regenerated by npm install
**/node_modules/**

# SQLite databases are machine-local
**/opencode.db
**/opencode.db-shm
**/opencode.db-wal

# Zsh completion cache is auto-generated
**/.zcompdump*

# Temp files with timestamp suffixes
*-[0-9]*

# Browser / Electron app profiles & caches (machine-local, huge)
BraveSoftware/**
chromium/**
obsidian/**
pulse/**

# GNOME/qsettings binary DBs (not text-controllable)
dconf/**

# Machine-local network / lib state
tailscale/**
libaccounts-glib/**

# Go telemetry
go/**

# Shell completion / app transient state
carapace/**

# Legacy backups & empty dirs
nvim.bak/**
kitty/**

# Alternate apps not in use
angelfish/**
nautilus/**

# Hermes/bot & misc transient files (pre-merge legacy flat pattern;
# dot_config/herdr config IS managed, only runtime state is ignored)
.config/herdr/.plugins.lock
.config/herdr/*.log
.config/herdr/plugins.json
.config/herdr/plugins/
.config/herdr/plugins.manifest.toml
.config/herdr/release-notes.json
.config/herdr/session.json
.config/herdr/sessions/
tool_state

# opencode runtime state (regenerated)
opencode/opencode-notifier-state.json
opencode/*.log

# Target-path equivalents for ~/.config entries
.config/BraveSoftware/**
.config/chromium/**
.config/obsidian/**
.config/pulse/**
.config/dconf/**
.config/tailscale/**
.config/libaccounts-glib/**
