.config/hypr/scripts
.config/hypr/scripts/**
{{- end }}

# ── Non-omarchy hosts: B's profile clutter ──────────────────────────────
# Non-omarchy hosts run no omarchy desktop (pinetab: foot; equil-remote:
# headless). The omarchy wide variant is ignored everywhere non-omarchy;
# the minimal/narrow variants deploy there so every width tier resolves.
{{ if not .omarchy }}
.config/ghostty
.config/ghostty/**
.config/waybar/config.jsonc
.config/uwsm
.config/uwsm/**
.config/starship/starship_omarchy.toml
{{ end }}

# ── Pinetab only: foot-tuned starship set owns its width tiers ──────────
# The pinetab runs foot with its own minimal/narrow/wide variants, so B's
# omarchy minimal/narrow presets would be dead weight and could collide
# with the router's tier paths.
{{ if and (not .omarchy) (eq .device.model "pinetab2") }}
.config/starship/starship_minimal.toml
.config/starship/starship_narrow.toml
{{ end }}

# ── Omarchy machines never get the pinetab's static waybar config ───────
{{ if .omarchy }}
.config/waybar/config
{{ end }}

# ── mako: omarchy3 uses the theme symlink; omarchy4 dropped mako entirely;
# pinetab uses the static config above. Gate each variant so the target is
# only ever claimed by one source entry (chezmoi rejects duplicates).
{{ if eq (includeTemplate "omarchyVersion" .) "omarchy4" }}
.config/waybar
.config/waybar/**
.config/mako
.config/mako/**
{{ end }}
{{ if or (not .omarchy) (ne (includeTemplate "omarchyVersion" .) "omarchy3") }}
.config/mako/symlink_config
{{ end }}
{{ if or .omarchy (ne .device.model "pinetab2") }}
.config/mako/config
{{ end }}

# ── Omarchy 3.x machines use hyprland.conf as the live entrypoint and keep
# their own hyprlang2lua-converted .lua copies; the 4.x .lua files are
# desktop-truth.
{{ if ne (includeTemplate "omarchyVersion" .) "omarchy4" }}
.config/hypr/*.lua
{{ end }}
