.config/nautilus/**
.config/tool_state
.config/opencode/opencode-notifier-state.json
.config/opencode/*.log
.config/opencode/bun.lock
.config/opencode/package-lock.json

# KDE/Plasma configs (host/DE-specific; not managed on Hyprland setup)
.config/akonadi/**
.config/akonadi_*
.config/baloofilerc
.config/bluedevilglobalrc
.config/kactivitymanagerd*
.config/kconf_updaterc
.config/kglobalshortcutsrc
.config/konsolerc
.config/konsolesshconfig
.config/kscreenlockerrc
