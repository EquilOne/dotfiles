# ── Desktop profile: Omarchy owns these paths and rewrites them on theme
# switch (~/.local/state/omarchy/current/theme), so chezmoi must not manage
# them — the vendored copies in the source are obsolete but kept as mapped
# fallbacks.
{{- if eq (index . "profile") "desktop" }}
.config/omarchy
.config/omarchy/**
.config/btop
.config/btop/**
.config/jolt
.config/jolt/**
.config/mdt
.config/mdt/**

# Renders empty on desktop; harmless remotely — do not move into the remote gate.
10_remote-fedora-setup.sh
