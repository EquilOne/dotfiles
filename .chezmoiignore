.config/tmux
.config/tmux/**
.config/nvim/lua/plugins/vim-tmux-navigator.lua
{{- end }}

# Desktop: Omarchy owns these paths and rewrites them on theme switch
# (~/.local/state/omarchy/current/theme), so chezmoi must not manage them —
# the vendored copies in the source are obsolete but kept as mapped fallbacks.
{{- if eq (index . "profile") "desktop" }}
.config/omarchy
.config/omarchy/**
.config/btop
.config/btop/**
.config/jolt
.config/jolt/**
.config/mdt
.config/mdt/**

# Renders empty on desktop; harmless remotely — do not move into the remote gate.
10_remote-fedora-setup.sh
{{- end }}

# OpenCode runtime package manifests — never managed, so a tracked stale copy
# can never downgrade the plugin SDK (e.g. 1.18.31 → 1.18.11).
.config/opencode/package.json
.config/opencode/package-lock.json

# Omarchy 3.x machines use hyprland.conf as the live entrypoint and keep their
# own hyprlang2lua-converted .lua copies; the 4.x .lua files are desktop-truth.
{{ if ne (includeTemplate "omarchyVersion" .) "omarchy4" }}
.config/hypr/*.lua
{{ end }}

# Omarchy 4 replaced waybar with omarchy-shell (quickshell) and dropped mako:
# nothing runs either, and ~/.local/state/omarchy/current/theme contains no
# waybar.css or mako.ini (the theme paths these files import point at the
# Omarchy 3.x ~/.config/omarchy/current/theme/ layout, dead on 4.x). Keep
# them managed only on Omarchy 3.x machines.
{{ if eq (includeTemplate "omarchyVersion" .) "omarchy4" }}
.config/waybar
.config/waybar/**
.config/mako
.config/mako/**
{{ end }}
