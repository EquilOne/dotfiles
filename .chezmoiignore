# other machine — omarchy desktops and remote servers get none of these.
{{- if ne .device.model "pinetab2" }}
.config/foot
.config/foot/**
.config/fuzzel
.config/fuzzel/**
.config/gtk-3.0
.config/gtk-3.0/**
.config/gtk-4.0
.config/gtk-4.0/**
.config/gtkrc
.config/gtkrc-2.0
.config/Thunar
.config/Thunar/**
.config/nwg-look
.config/nwg-look/**
.config/xsettingsd
.config/xsettingsd/**
.config/mimeapps.list
.config/user-dirs.dirs
.config/user-dirs.locale
.config/themes
.config/themes/**
.config/starship/starship_foot.toml
.config/starship/starship_foot_minimal.toml
.config/starship/starship_foot_narrow.toml
.config/zsh/.zprofile
# Classic hypr stack only — the .lua files stay managed for omarchy 4.x
