#!/bin/sh
# run_once_after: upsert agent-search keys from Proton Pass into
# ~/.hermes/.env (Hermes web search backends) and
# ~/.config/shell/env.local (OpenCode Exa websearch).
#
# Keys are resolved by chezmoi at render time via the protonPass template
# helper (name-based pass:// references; no key material in source).
# Machines without pass-cli render empty keys and upsert() skips them; a
# resolution failure while pass-cli is present aborts the render (defer
# with `chezmoi apply --skip-secrets`). Re-runs automatically whenever
# this script's content changes (run_once semantics) — including on key
# rotation, since rotated keys change the rendered content.

set -u

{{- $tavily := "" }}
{{- $brave := "" }}
{{- $exa := "" }}
{{- if lookPath "pass-cli" }}
{{-   $tavily = protonPass "pass://api-keys/agent-search-tavily/API Key" | trim }}
{{-   $brave = protonPass "pass://api-keys/agent-search-brave/API Key" | trim }}
{{-   $exa = protonPass "pass://api-keys/agent-search-exa/API Key" | trim }}
{{- end }}

upsert() {
    file="$1"; name="$2"; value="$3"
    [ -d "$(dirname "$file")" ] || return 0
    [ -n "$value" ] || return 0
    if grep -q "^${name}=" "$file" 2>/dev/null; then
        tmp=$(mktemp)
        grep -v "^${name}=" "$file" > "$tmp" && mv "$tmp" "$file"
    fi
    printf '%s=%s\n' "$name" "$value" >> "$file"
    chmod 600 "$file"
}

# Hermes web search backends
upsert "$HOME/.hermes/.env" TAVILY_API_KEY {{ $tavily | shellQuote }}
upsert "$HOME/.hermes/.env" BRAVE_SEARCH_API_KEY {{ $brave | shellQuote }}

# OpenCode built-in websearch (Exa)
upsert "$HOME/.config/shell/env.local" EXA_API_KEY {{ $exa | shellQuote }}
