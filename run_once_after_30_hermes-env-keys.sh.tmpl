#!/bin/sh
# run_once_after: upsert agent-search keys from Proton Pass into
# ~/.hermes/.env (Hermes web search backends) and
# ~/.config/shell/env.local (OpenCode Exa websearch).
#
# URIs are rendered by chezmoi; pass-cli prints the key directly as a bare
# line (captured on stdout), bounded by `timeout 15`, so this degrades
# gracefully on machines without pass-cli or without a login
# (keys are skipped; apply is not broken). Re-runs automatically whenever
# this script's content changes (run_once semantics).

set -u

SHARE='x6v_l6x0-oDmop2hr5ARX13aUEiHYOkpgWdYybtTfaMMr0GIjB27y0G3DoEq_ffUenAm8H8OVGLNJN_dlYCLbA=='

upsert() {
    file="$1"; name="$2"; uri="$3"
    [ -d "$(dirname "$file")" ] || return 0
    command -v pass-cli >/dev/null 2>&1 || return 0
    value=$(timeout 15 pass-cli item view "$uri" 2>/dev/null) || return 0
    [ -n "$value" ] || return 0
    if grep -q "^${name}=" "$file" 2>/dev/null; then
        tmp=$(mktemp)
        grep -v "^${name}=" "$file" > "$tmp" && mv "$tmp" "$file"
    fi
    printf '%s=%s\n' "$name" "$value" >> "$file"
    chmod 600 "$file"
}

# Hermes web search backends
upsert "$HOME/.hermes/.env" TAVILY_API_KEY "pass://$SHARE/4VquQmGnDOsK0P6wQzzIZLxlXpZVYCVFj8-Jj9v9ystH_rvsSTCqH3vwe__0UzK6393yx6kXvtLSM7k0O-GZrw==/API Key"
upsert "$HOME/.hermes/.env" BRAVE_SEARCH_API_KEY "pass://$SHARE/UJTlekIYUAqbBqBDmdi5aQID37Va3ezPEan-r6QEEe0_BNq5K0Q59amQ98RTCvpmgVZyq6Yh4S39ZoxPuPX5gA==/API Key"

# OpenCode built-in websearch (Exa)
upsert "$HOME/.config/shell/env.local" EXA_API_KEY "pass://$SHARE/O5EVgEW2QTBNY8nKbdpElUzMzB6NRTY9ujjLx5rZr-DRpl__XhWnObX2_dzkVaVDZA4xJI3ulOJJ7zvmSApJCA==/API Key"