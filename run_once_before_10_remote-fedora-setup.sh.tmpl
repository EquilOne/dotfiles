{{- if eq (index . "profile") "remote" -}}
#!/usr/bin/env bash

set -u
set -o pipefail

failed=0

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.opencode/bin:$PATH"

log() {
    printf '[remote-profile] %s\n' "$*"
}

warn() {
    printf '[remote-profile] warning: %s\n' "$*" >&2
}

fail() {
    failed=1
    warn "$*"
}

run_privileged() {
    command -v sudo >/dev/null 2>&1 || return 127
    sudo "$@"
}

run_installer() {
    local label="$1"
    local url="$2"
    local shell="$3"
    local installer
    shift 3

    local env_assignment=""
    if [ "${1:-}" = "--env" ]; then
        env_assignment="${2:-}"
        shift 2
    fi

    if ! command -v curl >/dev/null 2>&1; then
        fail "$label requires curl; see $url"
        return
    fi

    installer=$(mktemp) || {
        fail "could not create a temporary file for $label"
        return
    }

    if ! curl -fsSL --retry 3 --connect-timeout 10 --max-time 120 "$url" -o "$installer"; then
        rm -f "$installer"
        fail "could not download $label installer from $url"
        return
    fi

    if [ -n "$env_assignment" ]; then
        if ! env "$env_assignment" "$shell" "$installer" "$@"; then
            fail "$label installer failed; see $url"
        fi
    elif ! "$shell" "$installer" "$@"; then
        fail "$label installer failed; see $url"
    fi
    rm -f "$installer"
}

if [ "$(id -u)" -eq 0 ]; then
    fail "refusing to run as root; run chezmoi as the intended user"
    exit 1
fi

if ! mkdir -p "$HOME/.local/bin"; then
    fail "could not create $HOME/.local/bin"
fi

# Guarantee chezmoi in the canonical ~/.local/bin for post-init sessions.
if [ ! -x "$HOME/.local/bin/chezmoi" ]; then
    if command -v chezmoi >/dev/null 2>&1; then
        cp "$(command -v chezmoi)" "$HOME/.local/bin/chezmoi"
    else
        fail "chezmoi not found in PATH; install it with: sh -c \"curl -fsLS get.chezmoi.io\" -- -b \"$HOME/.local/bin\""
    fi
fi

fedora=false
if [ -f /etc/fedora-release ] || grep -qE '^ID(_LIKE)?=.*(fedora|rhel|centos|rocky|alma)' /etc/os-release 2>/dev/null; then
    fedora=true
fi

if [ "$fedora" != true ]; then
    fail "remote profile setup requires a Fedora-family system"
elif ! command -v dnf >/dev/null 2>&1; then
    fail "dnf is required for Fedora-family package setup"
elif ! command -v sudo >/dev/null 2>&1; then
    fail "sudo is required for Fedora package setup"
    exit 1
elif ! sudo -v; then
    fail "sudo authorization is required for remote profile setup; authenticate in the terminal, then rerun chezmoi apply"
    exit 1
else
    packages=(
        git curl file procps-ng jq zsh neovim fzf ripgrep fd-find bat zoxide direnv gh
        dnf-plugins-core gawk golang rust cargo
        gcc gcc-c++ make cmake pkgconf-pkg-config openssl-devel libffi-devel
        zlib-ng-compat-devel bzip2-devel xz-devel sqlite-devel readline-devel
        libyaml-devel tar unzip patch findutils ca-certificates
    )
    missing_packages=()
    for package in "${packages[@]}"; do
        if ! rpm -q "$package" >/dev/null 2>&1; then
            missing_packages+=("$package")
        fi
    done
    if [ "${#missing_packages[@]}" -gt 0 ] && ! run_privileged dnf install -y "${missing_packages[@]}"; then
        fail "Fedora package transaction failed"
    fi
fi

try_optional_dnf_package() {
    local package="$1"

    if rpm -q "$package" >/dev/null 2>&1; then
        return 0
    fi
    if [ "$fedora" != true ] || ! command -v dnf >/dev/null 2>&1 || ! command -v sudo >/dev/null 2>&1; then
        return 1
    fi
    run_privileged dnf install -y "$package"
}

# keychain provides a persistent ssh-agent for Proton-stored SSH keys.
# EPEL does not apply to Fedora; prefer the distro package, else install the
# single-script release from danielrobbins/keychain into ~/.local/bin.
if ! try_optional_dnf_package keychain && [ ! -x "$HOME/.local/bin/keychain" ]; then
    if curl -fsSL --retry 3 --connect-timeout 10 --max-time 60 \
        https://raw.githubusercontent.com/danielrobbins/keychain/2.9.8/keychain \
        -o "$HOME/.local/bin/keychain" && chmod 0755 "$HOME/.local/bin/keychain"; then
        :
    else
        log "warning: keychain could not be installed; SSH keys must be loaded manually via pass-cli ssh-agent load"
    fi
fi

install_eza() {
    if command -v eza >/dev/null 2>&1; then
        return
    fi
    if try_optional_dnf_package eza && command -v eza >/dev/null 2>&1; then
        return
    fi
    if command -v cargo >/dev/null 2>&1; then
        if ! cargo install --locked --root "$HOME/.local" eza; then
            fail "eza installation failed; see https://github.com/eza-community/eza/blob/main/INSTALL.md"
        fi
    else
        fail "eza requires Fedora dnf or Cargo; see https://github.com/eza-community/eza/blob/main/INSTALL.md"
    fi
    if ! command -v eza >/dev/null 2>&1; then
        fail "eza was not installed; see https://github.com/eza-community/eza/blob/main/INSTALL.md"
    fi
}

install_starship() {
    if command -v starship >/dev/null 2>&1; then
        return
    fi
    if try_optional_dnf_package starship && command -v starship >/dev/null 2>&1; then
        return
    fi
    run_installer "Starship" "https://starship.rs/install.sh" sh --yes --bin-dir "$HOME/.local/bin"
    if ! command -v starship >/dev/null 2>&1; then
        fail "Starship was not installed; see https://starship.rs/guide/#%F0%9F%9A%80-installation"
    fi
}

install_uv() {
    if command -v uv >/dev/null 2>&1; then
        return
    fi
    if try_optional_dnf_package uv && command -v uv >/dev/null 2>&1; then
        return
    fi
    run_installer "uv" "https://astral.sh/uv/install.sh" sh --env UV_NO_MODIFY_PATH=1
    if ! command -v uv >/dev/null 2>&1; then
        fail "uv was not installed; see https://docs.astral.sh/uv/getting-started/installation/"
    fi
}

install_eza
install_starship
install_uv

if [ ! -x "$HOME/.local/bin/opencode" ]; then
    if [ -x "$HOME/.opencode/bin/opencode" ]; then
        if ! cp "$HOME/.opencode/bin/opencode" "$HOME/.local/bin/opencode"; then
            fail "could not place OpenCode in $HOME/.local/bin"
        fi
    elif ! command -v opencode >/dev/null 2>&1; then
        run_installer "OpenCode" "https://opencode.ai/install" bash --env "OPENCODE_INSTALL_DIR=$HOME/.local/bin" --no-modify-path
        if [ ! -x "$HOME/.local/bin/opencode" ] && [ -x "$HOME/.opencode/bin/opencode" ]; then
            if ! cp "$HOME/.opencode/bin/opencode" "$HOME/.local/bin/opencode"; then
                fail "could not place OpenCode in $HOME/.local/bin"
            fi
        fi
    fi
fi

if [ ! -x "$HOME/.local/bin/opencode" ] && ! command -v opencode >/dev/null 2>&1; then
    fail "OpenCode was not installed"
fi

if ! command -v herdr >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/herdr" ]; then
    run_installer "Herdr" "https://herdr.dev/install.sh" sh
    if [ ! -x "$HOME/.local/bin/herdr" ] && ! command -v herdr >/dev/null 2>&1; then
        fail "Herdr was not installed"
    fi
fi

if ! command -v pass-cli >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/pass-cli" ]; then
    if ! command -v jq >/dev/null 2>&1; then
        fail "Proton Pass CLI requires jq; see https://proton.me/download/pass-cli/install.sh"
    else
        installer=$(mktemp) || {
            fail "could not create a temporary file for Proton Pass CLI"
            installer=""
        }
        if [ -n "$installer" ]; then
            if curl -fsSL --retry 3 --connect-timeout 10 --max-time 120 \
                https://proton.me/download/pass-cli/install.sh -o "$installer" && \
                env PROTON_PASS_CLI_INSTALL_CHANNEL=stable \
                    PROTON_PASS_CLI_INSTALL_DIR="$HOME/.local/bin" bash "$installer"; then
                :
            else
                fail "Proton Pass CLI installer failed; see https://proton.me/download/pass-cli/install.sh"
            fi
            rm -f "$installer"
        fi
    fi
    if [ ! -x "$HOME/.local/bin/pass-cli" ] && ! command -v pass-cli >/dev/null 2>&1; then
        fail "Proton Pass CLI was not installed"
    fi
fi

find_brew() {
    local candidate

    if command -v brew >/dev/null 2>&1; then
        command -v brew
        return 0
    fi

    for candidate in \
        "$HOME/.linuxbrew/bin/brew" \
        "/home/linuxbrew/.linuxbrew/bin/brew" \
        "/opt/homebrew/bin/brew" \
        "$HOME/.homebrew/bin/brew"; do
        if [ -x "$candidate" ]; then
            printf '%s\\n' "$candidate"
            return 0
        fi
    done

    return 1
}

install_homebrew() {
    local brew

    if brew=$(find_brew); then
        return 0
    fi

    log "installing Homebrew"
    run_installer "Homebrew" "https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh" bash --env NONINTERACTIVE=1

    if ! brew=$(find_brew); then
        fail "Homebrew was not installed; see https://docs.brew.sh/Homebrew-on-Linux"
        return 1
    fi

    # Make the newly installed Homebrew available to the rest of this run.
    if ! eval "$(\"$brew\" shellenv)"; then
        fail "could not initialize Homebrew environment"
        return 1
    fi
}

if ! command -v carapace >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/carapace" ]; then
    brew=""
    if install_homebrew && brew=$(find_brew); then
        log "installing Carapace with Homebrew"
        if ! "$brew" install carapace; then
            fail "Carapace Homebrew installation failed; see https://carapace-sh.github.io/carapace-bin/install.html"
        fi
    elif command -v go >/dev/null 2>&1; then
        log "installing Carapace with Go"
        if ! GOBIN="$HOME/.local/bin" go install github.com/carapace-sh/carapace-bin/cmd/carapace@latest; then
            fail "Carapace Go installation failed; see https://carapace-sh.github.io/carapace-bin/install.html"
        fi
    else
        fail "Carapace requires Homebrew or Go; see https://carapace-sh.github.io/carapace-bin/install.html"
    fi
    unset brew

    if [ ! -x "$HOME/.local/bin/carapace" ] && ! command -v carapace >/dev/null 2>&1; then
        fail "Carapace was not installed"
    fi
fi

if ! command -v yazi >/dev/null 2>&1 || ! command -v ya >/dev/null 2>&1; then
    if [ "$fedora" != true ] || ! command -v dnf >/dev/null 2>&1 || ! command -v sudo >/dev/null 2>&1; then
        fail "Yazi requires Fedora dnf and the documented COPR path: https://yazi-rs.github.io/docs/installation/"
    elif ! rpm -q dnf-plugins-core >/dev/null 2>&1; then
        fail "dnf-plugins-core is required for the documented Yazi COPR path"
    elif ! run_privileged dnf copr enable -y lihaohong/yazi; then
        fail "could not enable the documented Yazi COPR"
    elif ! run_privileged dnf install -y yazi; then
        fail "could not install Yazi from the documented Fedora COPR"
    fi
    if ! command -v yazi >/dev/null 2>&1 || ! command -v ya >/dev/null 2>&1; then
        fail "Yazi was not installed"
    fi
fi

if [ "$failed" -ne 0 ]; then
    warn "remote profile setup incomplete; chezmoi will retry"
fi
exit "$failed"
{{ end }}
